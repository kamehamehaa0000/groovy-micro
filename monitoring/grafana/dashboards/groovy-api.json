        "type": "prometheus",
        "uid": "groovy-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(groovy_metrics_collector_errors_total[1h:1m]))",
          "legendFormat": "errors",
          "datasource": {
