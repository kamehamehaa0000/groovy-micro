{
  "uid": "groovy-api-overview",
  "title": "Groovy API — Health & Latency",
  "description": "Latency percentiles per endpoint, error rates, traffic, SSE streams and backend health for the Groovy API.",
  "tags": [
    "groovy",
    "api"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Traffic",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per second, by endpoint",
      "description": "Which endpoints the app is actually busy with.",
      "datasource": {
        "type": "prometheus",
        "uid": "groovy-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (route) (rate(groovy_http_requests_total[5m])))",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "groovy-prometheus"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 6,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate",
      "datasource": {
        "type": "prometheus",
        "uid": "groovy-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(groovy_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(groovy_http_requests_total[5m])), 0.0001)",
          "legendFormat": "5xx share",
          "datasource": {
            "type": "prometheus",
            "uid": "groovy-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(groovy_http_requests_total{status=~\"4..\"}[5m])) / clamp_min(sum(rate(groovy_http_requests_total[5m])), 0.0001)",
          "legendFormat": "4xx share",
          "datasource": {
            "type": "prometheus",
            "uid": "groovy-prometheus"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 6,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requests in flight",
      "description": "Live requests being handled right now (streams excluded).",
      "datasource": {
        "type": "prometheus",
        "uid": "groovy-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "groovy_http_requests_in_flight",
          "legendFormat": "in flight",
          "datasource": {
            "type": "prometheus",
            "uid": "groovy-prometheus"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Latency",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency percentiles across all traffic",
      "description": "Half of requests are faster than p50; 95% faster than p95. This is the \"is the API slow?\" panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "groovy-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.9, sum by (route, le) (rate(groovy_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p90",
          "datasource": {
            "type": "prometheus",
            "uid": "groovy-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (route, le) (rate(groovy_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "groovy-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (route, le) (rate(groovy_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "groovy-prometheus"
          }
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 6,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "p95 latency by endpoint (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "groovy-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, histogram_quantile(0.95, sum by (route, le) (rate(groovy_http_request_duration_seconds_bucket[5m]))))",
          "datasource": {
            "type": "prometheus",
            "uid": "groovy-prometheus"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "p95 (seconds)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "p95 (seconds)",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "p99 latency by endpoint (5m)",
      "description": "The slowest 1% per endpoint — where the tail hurts.",
      "datasource": {
        "type": "prometheus",
        "uid": "groovy-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, histogram_quantile(0.99, sum by (route, le) (rate(groovy_http_request_duration_seconds_bucket[5m]))))",
          "datasource": {
            "type": "prometheus",
            "uid": "groovy-prometheus"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "p99 (seconds)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "p99 (seconds)",
            "desc": true
