PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/groovy
REDIS_URL=redis://localhost:6379
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars!
COOKIE_SECRET=super_secret_cookie_key_change_in_production_32chars!
CLIENT_URL=http://localhost:5173

# Token Lifetimes
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# Cloudflare R2 / S3 Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=groovy-media
CDN_BASE_URL=https://cdn.groovy.stream
